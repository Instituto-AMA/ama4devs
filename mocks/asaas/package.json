{
  "name": "asaas-mock-server",
  "version": "0.3.0",
  "description": "Simulador local fiel do sandbox Asaas — entrega webhooks em localhost",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "codegen": "bun tools/codegen/main.ts",
    "spec:fetch": "bun tools/spec-fetch.ts",
    "spec:diff": "bun tools/spec-diff.ts",
    "coverage:ops": "bun tools/coverage-ops.ts",
    "capture": "bun tools/capture.ts",
    "e2e": "bun tools/e2e.ts",
    "test:parity": "bun test tests/parity",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "release": "./tools/release.sh",
    "hub:overview": "bun tools/hub-overview.ts",
    "panel:dev": "vite --config panel/vite.config.ts panel",
    "panel:build": "vite build --config panel/vite.config.ts panel && cp panel/dist/index.html src/admin/ui.html",
    "panel:check": "tsc --noEmit -p panel/tsconfig.json"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.33",
    "drizzle-orm": "^0.44.2",
    "elysia": "^1.3.5"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.2.2",
    "@preact/preset-vite": "^2.10.5",
    "@types/bun": "^1.2.17",
    "drizzle-kit": "^0.31.1",
    "preact": "^10.29.7",
    "typescript": "^5.8.3",
    "vite": "^8.1.4",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
