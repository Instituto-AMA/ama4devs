# ─────────────────────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────────────────────
PORT=45445
TZ=America/Sao_Paulo
DATABASE_PATH=./data/asaas.db
LOG_LEVEL=info

# Semente do RNG. Fixa = IDs determinísticos (bom para testes/CI).
SEED=1

# ─────────────────────────────────────────────────────────────
# Conta principal (seed idempotente no boot)
# Se ASAAS_API_KEY não for definida, uma é gerada e IMPRESSA no boot.
# ─────────────────────────────────────────────────────────────
ASAAS_API_KEY=
SEED_ACCOUNT_NAME=Conta Principal
SEED_ACCOUNT_CPF_CNPJ=47960950000121
SEED_ACCOUNT_EMAIL=conta@localhost
SEED_ACCOUNT_BALANCE_CENTS=0

# ─────────────────────────────────────────────────────────────
# Relógio
#   REAL            = segue o relógio do sistema (default, paridade com dev)
#   VIRTUAL_FLOWING = offset do relógio real; o tempo anda, mas você pode pular
#   VIRTUAL_FROZEN  = só anda quando você chama /_admin/clock/advance (modo CI)
# ─────────────────────────────────────────────────────────────
CLOCK_MODE=REAL
CLOCK_START=
TICK_INTERVAL_MS=60000

# ─────────────────────────────────────────────────────────────
# Webhooks
#
# WEBHOOK_LOCALHOST_REWRITE: dentro do container, "localhost" é o PRÓPRIO
# container. Esta variável reescreve o host das URLs de webhook apontadas para
# localhost/127.0.0.1 para que o evento chegue na SUA máquina.
# Deixe vazio para desligar a reescrita (ex.: rodando fora do Docker).
# ─────────────────────────────────────────────────────────────
WEBHOOK_LOCALHOST_REWRITE=host.docker.internal
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=15
WEBHOOK_RETENTION_DAYS=14
WEBHOOK_MAX_PER_ACCOUNT=10

# ─────────────────────────────────────────────────────────────
# Regras de negócio (o Asaas real usa estes valores)
# ─────────────────────────────────────────────────────────────
SUBSCRIPTION_LOOKAHEAD_DAYS=40
CREDIT_CARD_SETTLEMENT_DAYS=32
DEBIT_CARD_SETTLEMENT_DAYS=3
SPLIT_DIVERGENCE_GRACE_BUSINESS_DAYS=2

# ─────────────────────────────────────────────────────────────
# Tabela de taxas — centavos e basis points (1 bp = 0,01%)
# ─────────────────────────────────────────────────────────────
FEE_BOLETO_CENTS=199
FEE_PIX_CENTS=199
FEE_CC_FIXED_CENTS=49
FEE_CC_PCT_BP_1X=299
FEE_CC_PCT_BP_2_6=349
FEE_CC_PCT_BP_7_12=399
FEE_CC_PCT_BP_13_21=429
FEE_DEBIT_FIXED_CENTS=35
FEE_DEBIT_PCT_BP=189
FEE_TED_CENTS=500
FEE_PIX_TRANSFER_CENTS=0

# ─────────────────────────────────────────────────────────────
# Admin (/_admin/*) — desligue em qualquer ambiente compartilhado
# ─────────────────────────────────────────────────────────────
ADMIN_ENABLED=true
