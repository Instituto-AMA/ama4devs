# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
PORT=45445
TZ=America/Sao_Paulo
DATABASE_PATH=./data/asaas.db
LOG_LEVEL=info

# The RNG seed. Fixed = deterministic ids (good for tests/CI).
SEED=1

# ─────────────────────────────────────────────────────────────
# Main account (idempotent seed on boot)
# If ASAAS_API_KEY is not set, one is generated and PRINTED on boot.
# ─────────────────────────────────────────────────────────────
ASAAS_API_KEY=
SEED_ACCOUNT_NAME=Conta Principal
SEED_ACCOUNT_CPF_CNPJ=47960950000121
SEED_ACCOUNT_EMAIL=conta@localhost
SEED_ACCOUNT_BALANCE_CENTS=0

# ─────────────────────────────────────────────────────────────
# Extra ROOT accounts, seeded on every boot (idempotent like the master
# account). Items of "apiKey|name|cpfCnpj" separated by ";". Empty = none.
# Each key must start with "$aact_" and differ from the master key.
# ─────────────────────────────────────────────────────────────
SEED_EXTRA_ACCOUNTS=
# SEED_EXTRA_ACCOUNTS=$aact_hmlg_dev_tenant_a|Clinica A|12345678000195;$aact_hmlg_dev_tenant_b|Clinica B|98765432000198

# ─────────────────────────────────────────────────────────────
# Clock
#   REAL            = follows the system clock (default, parity with dev)
#   VIRTUAL_FLOWING = offset of the real clock; time flows, but you can skip ahead
#   VIRTUAL_FROZEN  = only moves when you call /_admin/clock/advance (CI mode)
# ─────────────────────────────────────────────────────────────
CLOCK_MODE=REAL
CLOCK_START=
TICK_INTERVAL_MS=60000

# ─────────────────────────────────────────────────────────────
# Webhooks
#
# WEBHOOK_LOCALHOST_REWRITE: inside the container, "localhost" is the container
# ITSELF. This variable rewrites the host of the webhook URLs pointed at
# localhost/127.0.0.1 so that the event reaches YOUR machine.
# Leave it empty to turn the rewrite off (e.g. running outside Docker).
# ─────────────────────────────────────────────────────────────
WEBHOOK_LOCALHOST_REWRITE=host.docker.internal
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=15
WEBHOOK_RETENTION_DAYS=14
WEBHOOK_MAX_PER_ACCOUNT=10

# ─────────────────────────────────────────────────────────────
# Business rules (the real Asaas uses these values)
# ─────────────────────────────────────────────────────────────
SUBSCRIPTION_LOOKAHEAD_DAYS=40
CREDIT_CARD_SETTLEMENT_DAYS=32
DEBIT_CARD_SETTLEMENT_DAYS=3
SPLIT_DIVERGENCE_GRACE_BUSINESS_DAYS=2

# ─────────────────────────────────────────────────────────────
# Fee table — cents and basis points (1 bp = 0.01%)
# ─────────────────────────────────────────────────────────────
FEE_BOLETO_CENTS=199
FEE_PIX_CENTS=199
FEE_CC_FIXED_CENTS=49
FEE_CC_PCT_BP_1X=299
FEE_CC_PCT_BP_2_6=349
FEE_CC_PCT_BP_7_12=399
FEE_CC_PCT_BP_13_21=429
FEE_DEBIT_FIXED_CENTS=35
FEE_DEBIT_PCT_BP=189
FEE_TED_CENTS=500
FEE_PIX_TRANSFER_CENTS=0

# ─────────────────────────────────────────────────────────────
# Admin (/_admin/*) — turn it off in any shared environment
# ─────────────────────────────────────────────────────────────
ADMIN_ENABLED=true
