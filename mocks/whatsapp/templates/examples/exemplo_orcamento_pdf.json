{
	"name": "exemplo_orcamento_pdf",
	"language": "pt_BR",
	"category": "UTILITY",
	"components": [
		{
			"type": "HEADER",
			"format": "DOCUMENT",
			"example": { "header_handle": ["/settings/examples/media/orcamento.pdf"] }
		},
		{
			"type": "BODY",
			"text": "{{1}}, seu orçamento nº {{2}} está pronto: {{3}} no total, válido até {{4}}. O PDF segue acima.",
			"example": { "body_text": [["Mariana", "2026-0142", "R$ 2.150,00", "30/11/2026"]] }
		},
		{
			"type": "FOOTER",
			"text": "Em até 10x sem juros no cartão"
		},
		{
			"type": "BUTTONS",
			"buttons": [
				{
					"type": "URL",
					"text": "Ver orçamento",
					"url": "https://clinica.exemplo/orcamentos/{{1}}",
					"example": ["https://clinica.exemplo/orcamentos/2026-0142"]
				},
				{ "type": "QUICK_REPLY", "text": "Falar com a recepção" }
			]
		}
	]
}
