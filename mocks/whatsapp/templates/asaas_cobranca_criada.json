{
	"name": "asaas_cobranca_criada",
	"language": "pt_BR",
	"category": "UTILITY",
	"components": [
		{
			"type": "HEADER",
			"format": "TEXT",
			"text": "Nova cobrança"
		},
		{
			"type": "BODY",
			"text": "Olá, {{1}}! {{2}} gerou uma cobrança de {{3}} com vencimento em {{4}}. Pague por aqui: {{5}}"
		},
		{
			"type": "FOOTER",
			"text": "Enviado pelo Asaas (simulador)"
		}
	],
	"variables": {
		"1": { "description": "Nome do pagador", "example": "Maria" },
		"2": { "description": "Quem cobra", "example": "Clínica Exemplo" },
		"3": { "description": "Valor", "example": "R$ 150,00" },
		"4": { "description": "Vencimento", "example": "30/10/2026" },
		"5": { "description": "Link da fatura", "example": "http://localhost:45445/i/123456789012" }
	}
}
