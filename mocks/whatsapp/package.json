{
	"name": "whap",
	"version": "0.2.1",
	"description": "CLI and mock server for testing WhatsApp integration",
	"type": "module",
	"bin": {
		"whap": "./dist/whap"
	},
	"scripts": {
		"whap": "bun run src/index.ts",
		"build": "bun build src/index.ts --compile --outfile dist/whap ",
		"dev:server": "bun run --watch src/server/server.ts",
		"test": "bun --bun vitest run",
		"test:watch": "vitest --watch",
		"test:ui": "vitest --ui"
	},
	"dependencies": {
		"@effect/platform-bun": "4.0.6",
		"@hono/node-server": "^2.1.5",
		"@hono/node-ws": "^1.1.7",
		"@types/react": "^18.2.0",
		"@types/uuid": "^10.0.0",
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"chalk": "^5.3.0",
		"chokidar": "^4.0.3",
		"date-fns": "^3.6.0",
		"dotenv": "^16.5.0",
		"effect": "4.0.6",
		"hono": "^4.13.14",
		"ink": "^5.0.1",
		"ky": "^1.7.2",
		"react": "^18.2.0",
		"reconnecting-websocket": "^4.4.0",
		"uuid": "^14"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/bun": "^1.2.20",
		"@types/json-schema": "^7.0.15",
		"@types/ws": "^8.18.1",
		"@vitest/ui": "^4",
		"lefthook": "^1.11.13",
		"tsx": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-json-schema": "^0.65.1",
		"vitest": "^4"
	},
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3.14"
	}
}
