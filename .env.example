# Host port of the Asaas mock (panel and API).
ASAAS_PORT=45445
# Host port of the WhatsApp mock.
WHATSAPP_PORT=3010
# Asaas clock: REAL, VIRTUAL_FLOWING (time flows, can be skipped) or VIRTUAL_FROZEN.
ASAAS_CLOCK_MODE=VIRTUAL_FLOWING
# Extra Asaas accounts to seed on boot (leave empty for the main account only).
ASAAS_SEED_EXTRA_ACCOUNTS=
# Fake API key of the local Asaas mock (not a credential); empty = $aact_hmlg_local_master.
# Another key must be single-quoted, or compose reads its `$` as a variable: ASAAS_API_KEY='$aact_hmlg_...'
ASAAS_API_KEY=
# The Asaas mock sends its payer e-mails to Mailpit, its WhatsApp templates to the WhatsApp
# mock and its payer SMS to the SMS mock, all found by themselves: nothing to set here.
# Host port of Mailpit's UI (the mailbox of those e-mails).
MAILPIT_PORT=8025
# Where the WhatsApp mock posts webhook events (leave empty to configure it later).
WHATSAPP_WEBHOOK_URL=
# Secret used to sign WhatsApp webhooks with HMAC-SHA256 (x-hub-signature-256).
WHATSAPP_WEBHOOK_SECRET=
# Host port of the generator mock (fake people, companies, documents; UI and API).
GENERATOR_PORT=45450
# 1 starts the generator with the Asaas mock (default); 0 keeps it down.
GENERATOR_ENABLED=1
# Populate the Asaas mock once on boot when it has no customer yet, e.g.
# people=10,companies=3,charges=2,confirm=0.5 (leave empty to populate from the UI instead).
GENERATOR_ASAAS_SEED_ON_BOOT=
# Host port of the SMS mock (native, Twilio-compatible and simple send APIs; UI and API).
SMS_PORT=8899
# 1 starts the SMS mock with the Asaas mock (default); 0 keeps it down.
SMS_ENABLED=1
# Where the SMS mock posts webhook events (leave empty to configure it later).
SMS_WEBHOOK_URL=
# Secret used to sign SMS webhooks with HMAC-SHA256 (x-sms-signature).
SMS_WEBHOOK_SECRET=
