# Control keys (read by setup-sandbox.sh, never written to the target).
SANDBOX_NEEDS_KEY=1
SANDBOX_WEBHOOK_PATH=/webhooks/asaas

ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=${ASAAS_SANDBOX_API_KEY}
WHATSAPP_GRAPH_URL=https://graph.facebook.com
# The generator has no remote counterpart: it stays local even in the sandbox profile.
GENERATOR_URL=http://localhost:${GENERATOR_PORT}
# The SMS mock has no remote counterpart: it stays local even in the sandbox profile.
SMS_BASE_URL=http://localhost:${SMS_PORT}
