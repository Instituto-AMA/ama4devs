.env
.env.sandbox
# The official ElevenLabs CLI writes the key here (onboard connect).
.env.local
node_modules/
data/
# The rendered films are build artifacts; `make video` writes them.
video/out/
# The Pages site's API data is source (scripts/site-api-data.mjs writes it).
!site/data/
.DS_Store
_site/

# splinter (local config + token, sessions)
.splinter/

# impeccable live (session state and machine paths; the project config stays)
.impeccable/live/*
!.impeccable/live/config.json
